{
  admin off
  email {$TLS_EMAIL}
}
{$DOMAIN} {
  @private path /health/*
  respond @private 404
  encode zstd gzip
  reverse_proxy app:8080 {
    flush_interval -1
    # Do not trust client-supplied forwarding headers.
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Host {host}
  }
}
http://127.0.0.1:8081 {
  respond /health "OK"
}
