# Local example only. Never use these placeholders as credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://localhost:8080
# Runtime HTML mode for Fastify static serving. Pages build stays local.
APP_STORAGE_MODE=server
DATABASE_URL=postgresql://timeline_app:CHANGE_ME@127.0.0.1:5432/timeline
# Operator account, NOT the server runtime account. Remove from runtime environments.
MIGRATION_DATABASE_URL=postgresql://timeline_operator:CHANGE_ME@127.0.0.1:5432/timeline
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MAILER_MODE=memory
MAIL_FROM=timeline@example.test
# SMTP adapter requires TLS; memory mailer sends no external mail.
# MAILER_MODE=smtp
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# Used only for the offline owner bootstrap after email verification:
# BOOTSTRAP_OWNER_EMAIL=owner@example.test
# Database TLS: production requires verify-full. URL ssl* query parameters are rejected.
DB_SSL_MODE=disable
# DB_SSL_CA_FILE=/run/secrets/postgres-ca.pem
# Enable static serving after npm run build; Docker sets /app/dist automatically.
# STATIC_ROOT=/absolute/path/to/TIMELINE/dist
# Only explicit ingress IPs/CIDRs; default is no trusted proxy. Never true or /0.
# TRUST_PROXY=10.20.30.40/32
# Operator-only backup settings; never supply these to the running application:
# BACKUP_FILE=/backups/timeline.dump
# RESTORE_DATABASE_URL=postgresql://timeline_operator:CHANGE_ME@127.0.0.1:5432/timeline_restore_test
