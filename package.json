{
  "name": "production-timeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "server:dev": "tsx watch --env-file-if-exists=.env server/main.ts",
    "server:start": "tsx --env-file-if-exists=.env server/main.ts",
    "server:typecheck": "tsc -p tsconfig.server.json",
    "server:test": "vitest run --config vitest.server.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/cli.ts migrate",
    "db:status": "tsx --env-file-if-exists=.env server/cli.ts status",
    "server:bootstrap": "tsx --env-file-if-exists=.env server/cli.ts bootstrap"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@fastify/rate-limit": "11.2.1",
    "better-auth": "1.7.15",
    "dexie": "4.4.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
